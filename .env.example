# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jerseyhub"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Sandbox payment provider (Stripe test mode)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Telegram (store contact link, not a bot token — no credentials required)
NEXT_PUBLIC_TELEGRAM_USERNAME="jerseyhub_store"

# Demo admin account (used only by prisma/seed.ts for local dev)
SEED_ADMIN_EMAIL="admin@jerseyhub.example"
SEED_ADMIN_PASSWORD="change-me-now"
